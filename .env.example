# "Book a demo" form — copy to .env and fill in one option, then restart `npm run dev`.

# Option A: a form service or your own API that accepts a JSON POST
#   Formspree  -> https://formspree.io/f/<your-form-id>
#   Web3Forms  -> https://api.web3forms.com/submit  (also set the access key below)
VITE_CONTACT_ENDPOINT=
VITE_CONTACT_ACCESS_KEY=

# Option B (fallback): open the visitor's email app addressed to this inbox
VITE_CONTACT_EMAIL=
